@page "/projects/{Id:guid}/edit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject Planova.Projects.Application.IProjectService ProjectsService

<PageTitle>Edit project — PLANOVA</PageTitle><h1>Edit project</h1>
@if(_loading){<FoundationState Kind="Loading" Title="Loading project" Message="Loading the authoritative project record." />}
else if(_model is null){<FoundationState Kind="Forbidden" Title="Project unavailable" Message="The project does not exist or is outside your access scope." />}
else { @if(_message is not null){<p role="status">@_message</p>}<EditForm Model="_model" OnValidSubmit="SaveAsync" FormName="edit-project"><DataAnnotationsValidator/><ValidationSummary/><div class="admin-card">
<label>Name <InputText @bind-Value="_model.Name"/></label><label>Description <InputTextArea @bind-Value="_model.Description"/></label><label>Owning unit ID <InputText @bind-Value="_model.Unit"/></label><label>Manager user ID <InputText @bind-Value="_model.Manager"/></label><label>Sponsor user ID <InputText @bind-Value="_model.Sponsor"/></label><label>Project type <InputText @bind-Value="_model.Type"/></label><label>Delivery <InputSelect @bind-Value="_model.Method"><option>Agile</option><option>Waterfall</option><option>Hybrid</option><option>Operational</option></InputSelect></label><label>Priority <InputText @bind-Value="_model.Priority"/></label><label>Start <InputDate @bind-Value="_model.Start"/></label><label>Target end <InputDate @bind-Value="_model.End"/></label><label>Manual progress % <InputNumber @bind-Value="_model.Progress"/></label><label>Currency <InputText @bind-Value="_model.Currency"/></label><label>Reason for change <InputTextArea @bind-Value="_model.Reason"/></label><button type="submit">Save</button></div></EditForm>}
@code { [Parameter]public Guid Id{get;set;}private bool _loading=true;private string? _message;private FormModel? _model;private uint _version;
protected override async Task OnParametersSetAsync(){var r=await ProjectsService.GetAsync(Id,CancellationToken.None);if(r.IsSuccess){var x=r.Value!;_version=x.RowVersion;_model=new(){Name=x.Name,Description=x.Description,Unit=x.OwningOrganisationUnitId.ToString(),Manager=x.ManagerUserId.ToString(),Sponsor=x.SponsorUserId.ToString(),Type=x.ProjectType,Method=x.DeliveryMethod,Priority=x.Priority,Start=x.StartDate,End=x.TargetEndDate,Progress=x.ProgressPercentage,Currency=x.CurrencyCode};}_loading=false;}
private async Task SaveAsync(){if(!Guid.TryParse(_model!.Unit,out var unit)||!Guid.TryParse(_model.Manager,out var manager)||!Guid.TryParse(_model.Sponsor,out var sponsor)){_message="Unit, manager, and sponsor must be valid IDs.";return;}var r=await ProjectsService.UpdateAsync(Id,new(_model.Name,_model.Description,unit,sponsor,manager,_model.Type,_model.Method,_model.Priority,_model.Start,_model.End,_model.Progress,_model.Currency,_model.Reason,_version),CancellationToken.None);if(r.IsSuccess){_version=r.Value!.RowVersion;_message="Project saved.";}else _message=r.Error?.Message;}
private sealed class FormModel{[System.ComponentModel.DataAnnotations.Required]public string Name{get;set;}="";public string? Description{get;set;}public string Unit{get;set;}="";public string Manager{get;set;}="";public string Sponsor{get;set;}="";public string Type{get;set;}="";public string Method{get;set;}="Hybrid";public string Priority{get;set;}="";public DateOnly Start{get;set;}public DateOnly End{get;set;}public decimal Progress{get;set;}public string Currency{get;set;}="AED";[System.ComponentModel.DataAnnotations.Required]public string Reason{get;set;}="";}}
